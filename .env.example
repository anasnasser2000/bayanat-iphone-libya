# انسخ هذا الملف إلى .env (لا ترفع .env إلى GitHub)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# اجعلها true إذا كانت قاعدة البيانات المستضافة تتطلب SSL
PGSSL=false
PORT=3000
NODE_ENV=production
# رابط الموقع النهائي (يُستخدم في معاينة فيسبوك Open Graph)
PUBLIC_URL=https://example.com
# عدد الأسئلة التي يجب أن يجيبها المدعو لتُحتسب الإحالة
REFERRAL_MIN_ANSWERS=3
# نقاط مكافأة الداعي عن كل إحالة مؤهلة
REFERRAL_BONUS=10
